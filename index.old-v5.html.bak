<!-- HERO -->
<section class="hero wrap">
  <div class="hero-inner">
    <div class="hero-copy reveal">
      <span class="hero-kick"><span class="pip"></span> NULLBYTE · operator deck</span>
      <h1 class="hero-title">Your toolkit.<br><em>Your rules.</em></h1>
      <p class="hero-sub">No gatekeeping. No fluff. Every hacker tool, OSINT module and concept — decoded from beginner to pro, and built entirely in the open. Runs 100% in your browser.</p>
      <div class="hero-cta">
        <a class="btn-neon" href="tools.html"><svg class="ico"><use href="#i-wrench"/></svg> Open the toolkit</a>
        <a class="btn-wire" href="osint.html"><svg class="ico"><use href="#i-scope"/></svg> Launch OSINT</a>
      </div>
      <div class="hero-meta"><span><b>40+</b> tools</span><span><b>30</b> OSINT modules</span><span><b>200+</b> terms</span><span><b>100%</b> client-side</span></div>
    </div>

    <div class="hero-side reveal">
      <div class="ghost-wrap">
        <svg class="ghost" viewBox="0 0 32 32" role="img" aria-label="NULLBYTE ghost">
          <defs><linearGradient id="gHero" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#ffd9b8"/></linearGradient></defs>
          <path d="M5.4 14.5C5.4 7.2 10.1 2.4 16 2.4s10.6 4.8 10.6 12.1v12.8c0 1.2-1.4 1.7-2.2.9l-2.2-2.1c-.6-.6-1.6-.6-2.2 0l-2 2c-.7.7-1.8.7-2.5 0l-1.5-1.5c-.6-.6-1.6-.6-2.2 0l-2 2c-.6.6-1.6.6-2.2 0l-1.6-1.6c-.4-.4-.6-.9-.6-1.4Z" fill="url(#gHero)"/>
          <ellipse cx="11.8" cy="13.8" rx="2.5" ry="2.8" fill="#16100a"/>
          <ellipse cx="20.2" cy="13.8" rx="2.5" ry="2.8" fill="#16100a"/>
          <circle cx="12.7" cy="12.7" r=".85" fill="#fff"/>
          <circle cx="21.1" cy="12.7" r=".85" fill="#fff"/>
          <path d="M13.5 17.4h5L16 21.4Z" fill="var(--accent)"/>
        </svg>
      </div>
      <div class="term">
        <div class="term-bar"><i></i><i></i><i></i><span>operator@nullbyte:~</span></div>
        <div class="term-body" id="term"></div>
      </div>
    </div>
  </div>
</section>

<!-- PILLARS -->
<section class="wrap" style="margin-top:26px">
  <div class="sec-head"><span class="idx">[ 01 ]</span><h2>The platform</h2><a class="more" href="features.html">All features <svg class="ico ico-sm"><use href="#i-arrow-ur"/></svg></a></div>
