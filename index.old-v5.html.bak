        <circle class="n" cx="40" cy="40" r="4"/><circle class="n" cx="165" cy="55" r="4"/><circle class="n" cx="55" cy="150" r="4"/><circle class="n" cx="150" cy="150" r="4"/><circle class="n" cx="100" cy="30" r="4"/>
