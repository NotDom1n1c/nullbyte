<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NULLBYTE — IT Tools, Decoded</title>
<link rel="stylesheet" href="css/style.css?v=8">
<style>
/* ============================================================
   FRONT PAGE — "cyber-grid" cover theme (scoped to this page only)
   Electric cyan + magenta neon on deep space-navy. Retints the
   shared nav/footer via local var overrides on body.t-cyber.
   ============================================================ */
/* default theme = cyan; nbApplyTheme() (app.js) overrides these on <body> when
   the user picks another accent in account settings, so the whole front page —
   ghost nose, halo, grid, glows — re-tints too. */
body.t-cyber {
  --bg: #05060f; --bg-1: #070912; --ink: #eaf6ff; --muted: #93a7c4; --faint: #56617e;
  --line: rgba(120,180,255,0.12); --line-2: rgba(120,200,255,0.26);
  --violet: #22e0ff; --violet-2: #8beeff; --fuchsia: #22e0ff;
  --accent: #22e0ff; --accent-ink: #04222b; --glowcol: 34, 224, 255;
  --grad: linear-gradient(120deg, #8beeff, #22e0ff);
  --cyan: var(--accent); --mag: var(--violet-2);   /* alias page-local colours to the theme so they retint too */
  background: var(--bg);
}
body.t-cyber::before, body.t-cyber::after { display: none; } /* kill the shared orange edge-glow + grain */

/* animated cyber background */
.cyber-bg { position: fixed; inset: 0; z-index: -2; overflow: hidden; background:
  radial-gradient(120% 80% at 50% -10%, rgba(var(--glowcol),.16), transparent 55%),
  radial-gradient(90% 70% at 85% 20%, rgba(var(--glowcol),.14), transparent 55%),
  radial-gradient(80% 60% at 10% 90%, rgba(var(--glowcol),.14), transparent 55%),
  #05060f; }
/* perspective grid floor */
.cyber-grid { position: absolute; left: -20%; right: -20%; bottom: -10%; height: 62%;
  background-image: linear-gradient(rgba(var(--glowcol),.32) 1px, transparent 1px), linear-gradient(90deg, rgba(var(--glowcol),.28) 1px, transparent 1px);
  background-size: 46px 46px;
  transform: perspective(340px) rotateX(64deg); transform-origin: 50% 100%;
  mask-image: linear-gradient(transparent, #000 40%, #000); -webkit-mask-image: linear-gradient(transparent, #000 40%, #000);
  animation: gridpull 3.2s linear infinite; }
@keyframes gridpull { to { background-position: 0 46px, 0 0; } }
/* scanlines */
.cyber-scan { position: fixed; inset: 0; z-index: -1; pointer-events: none; opacity: .5;
  background: repeating-linear-gradient(to bottom, rgba(0,0,0,0) 0, rgba(0,0,0,0) 2px, rgba(0,0,0,.16) 3px); }

/* ============================ HERO ============================ */
.hero { position: relative; overflow: visible; padding-block: 44px 48px; }
.hero-inner { display: grid; grid-template-columns: 1.05fr .95fr; gap: 44px; align-items: center; }
.ghost-wrap { position: relative; display: grid; place-items: center; }
.ghost-wrap::before { content: ""; position: absolute; width: min(66%, 320px); aspect-ratio: 1; border-radius: 50%; z-index: 0;
  background: radial-gradient(circle, rgba(var(--glowcol),.5), rgba(var(--glowcol),.16) 46%, transparent 70%); filter: blur(10px); animation: halo 6s ease-in-out infinite; }
@keyframes halo { 0%,100% { transform: scale(1); opacity:.9 } 50% { transform: scale(1.08); opacity:.6 } }
.ghost { position: relative; z-index: 1; width: clamp(150px, 21vw, 250px); height: auto;
  filter: drop-shadow(0 0 22px rgba(var(--glowcol),.8)) drop-shadow(0 0 46px rgba(var(--glowcol),.4)); animation: float 5.5s ease-in-out infinite; }
@keyframes float { 0%,100% { transform: translateY(0) } 50% { transform: translateY(-16px) } }

.hero-kick { display: inline-flex; align-items: center; gap: 9px; font-family: var(--mono); font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; color: var(--cyan); border: 1px solid var(--line-2); border-radius: 999px; padding: 6px 14px; box-shadow: 0 0 20px -6px var(--cyan); background: rgba(var(--glowcol),.05); }
.hero-kick .pip { width: 6px; height: 6px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 10px var(--cyan); animation: pulse 2s infinite; }
.hero-title { font-family: var(--display); font-weight: 800; font-size: clamp(2.7rem, 6.4vw, 5.4rem); line-height: .9; letter-spacing: -.035em; margin: 22px 0 0; color: #fff;
  text-shadow: 0 0 22px rgba(var(--glowcol),.55), 0 0 46px rgba(var(--glowcol),.28); }
.hero-title em { font-style: italic; display: block; color: transparent; -webkit-text-fill-color: transparent;
  background: linear-gradient(92deg, var(--accent), var(--violet-2) 45%, var(--violet-2)); -webkit-background-clip: text; background-clip: text;
  filter: drop-shadow(0 0 20px rgba(var(--glowcol),.55)); }
.hero-sub { max-width: 46ch; margin: 22px 0 0; color: var(--muted); font-size: 1.05rem; line-height: 1.6; }
.hero-cta { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
.btn-neon { display: inline-flex; align-items: center; gap: 10px; font-family: var(--mono); font-weight: 700; font-size: .8rem; letter-spacing: .04em; text-transform: uppercase; color: var(--accent-ink); padding: 13px 24px; border-radius: 11px;
  background: linear-gradient(120deg, var(--accent), var(--violet-2)); box-shadow: 0 0 26px -4px rgba(var(--glowcol),.8); transition: transform .16s, box-shadow .16s, filter .16s; }
.btn-neon:hover { transform: translateY(-2px); box-shadow: 0 0 40px -2px rgba(var(--glowcol),1); filter: brightness(1.08); }
.btn-wire { display: inline-flex; align-items: center; gap: 10px; font-family: var(--mono); font-weight: 600; font-size: .8rem; letter-spacing: .04em; text-transform: uppercase; color: var(--cyan); padding: 13px 22px; border-radius: 11px; border: 1px solid var(--line-2); background: rgba(var(--glowcol),.04); transition: .16s; }
.btn-wire:hover { border-color: var(--cyan); box-shadow: 0 0 22px -6px var(--cyan); color: #fff; }
.hero-meta { margin-top: 24px; font-family: var(--mono); font-size: .74rem; letter-spacing: .04em; color: var(--faint); display: flex; gap: 18px; flex-wrap: wrap; }
.hero-meta b { color: var(--cyan); font-weight: 600; }

/* terminal */
.term { border: 1px solid var(--line-2); border-radius: 14px; overflow: hidden; background: rgba(5,8,18,.72); backdrop-filter: blur(10px); box-shadow: 0 0 44px -14px rgba(var(--glowcol),.6), inset 0 1px 0 rgba(255,255,255,.05); margin-top: 30px; }
.term-bar { display: flex; align-items: center; gap: 8px; padding: 11px 15px; border-bottom: 1px solid var(--line); background: rgba(var(--glowcol),.04); }
.term-bar i { width: 11px; height: 11px; border-radius: 50%; }
.term-bar i:nth-child(1){ background:var(--violet-2); box-shadow:0 0 8px var(--violet-2); } .term-bar i:nth-child(2){ background:#ffd34e; } .term-bar i:nth-child(3){ background:var(--accent); box-shadow:0 0 8px var(--accent); }
.term-bar span { margin-left: 8px; font-family: var(--mono); font-size: .72rem; color: var(--faint); }
.term-body { padding: 16px 18px; font-family: var(--mono); font-size: .82rem; line-height: 1.75; min-height: 172px; color: var(--muted); }
.term-body .ln { white-space: pre-wrap; }
.term-body .p { color: var(--cyan); } .term-body .ok { color: #4dffa6; } .term-body .dim { color: var(--faint); }
.term-cursor { display: inline-block; width: 8px; height: 15px; background: var(--cyan); vertical-align: -2px; box-shadow: 0 0 8px var(--cyan); animation: blink 1s steps(1) infinite; }
@keyframes blink { 50% { opacity: 0; } }

/* ============================ BENTO ============================ */
.bento { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(150px, auto); gap: 14px; }
.bcard { position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: rgba(10,14,26,.55); backdrop-filter: blur(12px); box-shadow: inset 0 1px 0 rgba(255,255,255,.05); padding: 22px 24px; display: flex; flex-direction: column; transition: transform .18s, border-color .18s, box-shadow .18s; }
.bcard::after { content: ""; position: absolute; inset: 0; border-radius: 16px; padding: 1px; background: linear-gradient(135deg, rgba(var(--glowcol),.5), transparent 40%, transparent 60%, rgba(var(--glowcol),.5)); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: .5; transition: opacity .2s; pointer-events: none; }
.bcard:hover { transform: translateY(-5px); box-shadow: 0 24px 60px -24px rgba(var(--glowcol),.6); }
.bcard:hover::after { opacity: 1; }
.bcard .ic { width: 42px; height: 42px; border-radius: 11px; display: grid; place-items: center; color: var(--cyan); background: rgba(var(--glowcol),.10); border: 1px solid rgba(var(--glowcol),.3); box-shadow: 0 0 20px -8px var(--cyan); }
.bcard .ic .ico { width: 22px; height: 22px; }
.bcard .kick { font-family: var(--mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: var(--faint); margin-top: 16px; }
.bcard h3 { font-size: 1.35rem; margin: 4px 0 6px; letter-spacing: -.01em; }
.bcard p { color: var(--muted); font-size: .9rem; line-height: 1.5; }
.bcard .foot { margin-top: auto; padding-top: 16px; display: flex; align-items: center; justify-content: space-between; font-family: var(--mono); font-size: .72rem; color: var(--faint); }
.bcard .foot .go { color: var(--cyan); display: inline-flex; align-items: center; gap: 6px; transition: transform .18s; }
.bcard:hover .foot .go { transform: translateX(3px); }
.b-osint { grid-column: span 2; grid-row: span 2; }
.b-osint::after { background: linear-gradient(135deg, rgba(var(--glowcol),.6), transparent 42%, transparent 58%, rgba(var(--glowcol),.6)); }
.b-osint h3 { font-size: 1.9rem; }
.b-osint p { font-size: .98rem; max-width: 40ch; }
.osint-viz { position: absolute; right: -30px; top: 10px; width: 260px; height: 260px; opacity: .55; pointer-events: none; }
.osint-viz circle.n { fill: var(--cyan); } .osint-viz line { stroke: var(--cyan); stroke-opacity: .32; stroke-width: 1; }
.osint-viz .core { fill: var(--mag); filter: drop-shadow(0 0 6px var(--mag)); }

/* featured tools */
.feat { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
.fcard { border: 1px solid var(--line); border-radius: 13px; background: rgba(10,14,26,.5); backdrop-filter: blur(8px); padding: 16px; text-align: left; transition: .18s; display: flex; flex-direction: column; gap: 10px; min-height: 132px; }
.fcard:hover { border-color: var(--cyan); transform: translateY(-3px); box-shadow: 0 16px 40px -20px var(--cyan); }
.fcard .ic { width: 34px; height: 34px; border-radius: 9px; display: grid; place-items: center; color: var(--cyan); background: rgba(var(--glowcol),.09); border: 1px solid rgba(var(--glowcol),.24); }
.fcard .ic .ico { width: 18px; height: 18px; }
.fcard b { font-size: .96rem; color: var(--ink); }
.fcard span { font-family: var(--mono); font-size: .68rem; color: var(--faint); margin-top: auto; }

/* stats band */
.statband { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; border: 1px solid var(--line-2); border-radius: 16px; overflow: hidden; background: var(--line-2); box-shadow: 0 0 44px -18px rgba(var(--glowcol),.6); }
.statband > div { background: rgba(8,11,22,.85); padding: 28px 26px; }
.statband .n { font-family: var(--display); font-weight: 800; font-size: 2.6rem; line-height: 1; color: var(--cyan); text-shadow: 0 0 20px rgba(var(--glowcol),.5); }
.statband .l { font-family: var(--mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); margin-top: 8px; }

.sec-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 22px; }
.sec-head .idx { font-family: var(--mono); font-size: .8rem; color: var(--mag); letter-spacing: .1em; }
.sec-head h2 { font-family: var(--display); font-style: italic; font-weight: 700; font-size: 1.6rem; }
.sec-head .more { margin-left: auto; font-family: var(--mono); font-size: .74rem; color: var(--muted); display: inline-flex; align-items: center; gap: 6px; }
.sec-head .more:hover { color: var(--cyan); }

/* retint shared nav/footer for this page */
body.t-cyber .nav { background: rgba(5,8,18,.72); border-bottom-color: var(--line); }
body.t-cyber .nav-links a:hover { color: var(--cyan); }
body.t-cyber .footer a:hover { color: var(--cyan); }
body.t-cyber .statusbar .live i { background: var(--cyan); box-shadow: 0 0 10px var(--cyan); }
body.t-cyber .btn-primary { background: linear-gradient(120deg,var(--accent),var(--violet-2)); color:var(--accent-ink); box-shadow: 0 0 24px -6px var(--cyan); }

@media (max-width: 940px){
  .hero-inner { grid-template-columns: 1fr; gap: 12px; text-align: center; }
  .ghost-wrap { order: -1; }
  .hero-kick, .hero-cta, .hero-meta { justify-content: center; }
  .hero-sub { margin-inline: auto; }
  .term { text-align: left; }
  .bento { grid-template-columns: 1fr 1fr; }
  .b-osint { grid-column: span 2; grid-row: span 1; }
  .feat { grid-template-columns: 1fr 1fr 1fr; }
  .statband { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 560px){
  .bento, .b-osint { grid-column: span 1; }
  .bento { grid-template-columns: 1fr; }
  .feat { grid-template-columns: 1fr 1fr; }
}
</style>
</head>
<body class="t-cyber">

<div class="cyber-bg"><div class="cyber-grid"></div></div>
<div class="cyber-scan"></div>

