<script src="js/app.js?v=33"></script>
<script>
(function(){
  const clk = document.getElementById('clock');
  function tick(){ if (clk) clk.textContent = new Date().toLocaleTimeString('en-GB'); }
  tick(); setInterval(tick, 1000);

  const term = document.getElementById('term');
  const LINES = [
    { t: '$ nullbyte --status', c: 'p' },
    { t: '[ok] 40+ interactive tools online', c: 'ok' },
    { t: '[ok] 30 OSINT modules armed', c: 'ok' },
    { t: '[ok] 200+ glossary terms indexed', c: 'ok' },
    { t: '[ok] backend: nullbyte-osint.workers.dev', c: 'ok' },
    { t: '// no accounts. no tracking. no servers.', c: 'dim' },
    { t: '> ready — pick a tool ↑', c: 'p' }
  ];
  let li = 0, ci = 0, rendered = '';
  function type(){
    if (!term) return;
    if (li >= LINES.length){ setTimeout(() => { li = 0; ci = 0; rendered = ''; term.innerHTML = '<span class="term-cursor"></span>'; type(); }, 4200); return; }
    const line = LINES[li];
    if (ci <= line.t.length){
      const partial = line.t.slice(0, ci).replace(/&/g,'&amp;').replace(/</g,'&lt;');
      term.innerHTML = rendered + `<div class="ln ${line.c}">${partial}<span class="term-cursor"></span></div>`;
      ci++;
      setTimeout(type, 16 + Math.random()*26);
    } else {
      rendered += `<div class="ln ${line.c}">${line.t.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</div>`;
      li++; ci = 0;
      setTimeout(type, 260);
    }
  }
  type();
})();
</script>
</body>
